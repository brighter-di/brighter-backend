# Brighter backend. Every value here is server-side only — nothing is ever
# sent to the browser. Locally, `brighterd` loads ./.env (without overriding
# the real environment); in production systemd reads /etc/brighter-backend/env.

DATABASE_URL=postgres://brighter:CHANGE_ME@127.0.0.1:5432/brighter?sslmode=disable

# The backtest engine — dashboard → Settings → API Access. Only one key pair is active
# at a time; generating a new one revokes the old. Grants the same access as
# the user who created it.
BACKTEST_ENGINE_API_KEY_ID=
BACKTEST_ENGINE_API_SECRET=

# Independent Go historical-price indexer. Empty uses existing Nasdaq history.
# Charts use provider closes (Yahoo includes splits); backtests use adjusted snapshots.
# HISTORICAL_PRICES_URL=http://127.0.0.1:8089

# The portfolio engine tenant key. Tenant-wide: it can create strategies and withdraw
# from any portfolio in the tenant. Never copy it anywhere else.
PORTFOLIO_ENGINE_API_KEY=
# PORTFOLIO_ENGINE_BASE_URL=https://portfolio-engine.example.com/v2

# Chains open for new investment (registry chain ids). 56 = BNB Chain, 1 = Ethereum.
CHAINS=56

# Operator notifications to Telegram: new wallets and portfolios, allocation
# changes, Invest now, withdrawals, re-evaluation errors. Both are needed.
# The chat id comes from getUpdates after someone messages the bot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Optional ─────────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=3200
# CORS_ORIGINS=https://brighter.fi,https://www.brighter.fi,https://studio.brighter.fi,http://localhost:3000
# TRUST_PROXY=false            # true behind nginx (uses X-Real-IP)
# LOG_LEVEL=info               # debug | info | warn | error
# LOG_FORMAT=json              # json | text
# ADMIN_TOKEN=                 # enables /v1/admin/*; empty = disabled
# WARMUP=true                  # precompute default backtests/targets

# portfolio engine strategy settings (applied when a strategy is created).
# Interval by default. A cron (e.g. "30 10 * * 1-5" = weekdays 10:30 New
# York, inside US market hours where Ondo trades) needs the portfolio engine to enable
# cron schedules for the tenant first — it currently rejects them.
# PORTFOLIO_ENGINE_SCHEDULE_FREQUENCY=hourly      # hourly | daily | weekly | monthly
# PORTFOLIO_ENGINE_SCHEDULE_CRON=
# PORTFOLIO_ENGINE_SCHEDULE_TZ=America/New_York
# PORTFOLIO_ENGINE_SLIPPAGE_BPS=50
# PORTFOLIO_ENGINE_PRICE_IMPACT_BPS=100

# Standing re-evaluation (needs both the backtest engine and the portfolio engine).
# SCHEDULER=true
# SCHEDULE_CHECK_AFTER=21:30   # earliest UTC time on a weekday; a floor, not a deadline
# SCHEDULE_TICK=30m
# SCHEDULE_MAX_ATTEMPTS=6      # per combo per day, then wait for the next trading day
# EVALUATION_RETENTION_DAYS=90 # routine evaluations kept this long; published ones forever; 0 = keep all
# MAX_CUTOFF_AGE_TRADING_DAYS=3
# MAX_DATA_LAG_DAYS=4
